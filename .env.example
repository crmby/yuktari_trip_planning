# Локальный запуск. Секреты в чат и Git не добавлять.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Домен портала без протокола; обязателен для режима bitrix.
B24_DOMAIN=
# Для деплоя на уже существующий сервер VibeCode:
SERVER_ID=
VIBE_API_KEY=
# Необязательно: 1–2 строки «что нового»; при обновлении попадут подписчикам приложения.
# Без значения используется описание изменений версии 0.3 из скрипта доставки.
DEPLOY_CHANGELOG=
# Для синхронизации CRM — OAuth-ключ приложения, а не ключ управления сервером.
# Оставьте APP_MODE=demo для локального демо; на сервере задайте bitrix.
APP_MODE=demo
VIBE_APP_KEY=
APP_URL=
# На сервере каталог должен переживать перевыкладку кода и находиться вне public.
DATA_DIR=
# ID сотрудников, которым разрешено менять мастеров/графики (через запятую).
# Администратор портала получает это право после проверки /users/me.
PLANNER_MANAGER_IDS=
# Необязательно: если настройки поля маршрута не возвращают ID/тип инфоблока.
B24_ROUTE_IBLOCK_ID=
B24_ROUTE_IBLOCK_TYPE=lists
